{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ken-guru/git-city/main/schema/theme.schema.json",
  "title": "git-city theme",
  "description": "A Theme pack: data only, executes no code. Every Role, plus a fallback, needs a noun and a palette hue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "display", "wordPieces", "streetSuffixes", "roleNouns", "palette"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "wordPieces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes", "suffixes"],
      "properties": {
        "prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z]+$" } },
        "suffixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]+$" } }
      }
    },
    "streetSuffixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z ]+$" } },
    "roleNouns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "docs", "api", "ui", "auth", "data", "cli", "infra", "utils", "core", "config", "build", "fallback"],
      "properties": {
        "tests": { "$ref": "#/$defs/noun" },
        "docs": { "$ref": "#/$defs/noun" },
        "api": { "$ref": "#/$defs/noun" },
        "ui": { "$ref": "#/$defs/noun" },
        "auth": { "$ref": "#/$defs/noun" },
        "data": { "$ref": "#/$defs/noun" },
        "cli": { "$ref": "#/$defs/noun" },
        "infra": { "$ref": "#/$defs/noun" },
        "utils": { "$ref": "#/$defs/noun" },
        "core": { "$ref": "#/$defs/noun" },
        "config": { "$ref": "#/$defs/noun" },
        "build": { "$ref": "#/$defs/noun" },
        "fallback": { "$ref": "#/$defs/noun" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "docs", "api", "ui", "auth", "data", "cli", "infra", "utils", "core", "config", "build", "fallback"],
      "properties": {
        "tests": { "$ref": "#/$defs/swatch" },
        "docs": { "$ref": "#/$defs/swatch" },
        "api": { "$ref": "#/$defs/swatch" },
        "ui": { "$ref": "#/$defs/swatch" },
        "auth": { "$ref": "#/$defs/swatch" },
        "data": { "$ref": "#/$defs/swatch" },
        "cli": { "$ref": "#/$defs/swatch" },
        "infra": { "$ref": "#/$defs/swatch" },
        "utils": { "$ref": "#/$defs/swatch" },
        "core": { "$ref": "#/$defs/swatch" },
        "config": { "$ref": "#/$defs/swatch" },
        "build": { "$ref": "#/$defs/swatch" },
        "fallback": { "$ref": "#/$defs/swatch" }
      }
    }
  },
  "$defs": {
    "noun": { "type": "string", "pattern": "^[A-Za-z]+( [A-Za-z]+)*$", "maxLength": 24 },
    "swatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue"],
      "properties": { "hue": { "type": "number", "minimum": 0, "maximum": 360 } }
    }
  }
}
