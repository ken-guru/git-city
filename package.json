{
  "name": "git-city",
  "version": "0.0.0",
  "description": "Turn a git history into an animated low-poly 3D city on a static webpage.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-city": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken-guru/git-city.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:grammars && npm run build:page",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:grammars": "node scripts/copy-grammars.mjs",
    "build:page": "node scripts/build-page.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  }
}
