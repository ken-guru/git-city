{
  "name": "git-city",
  "version": "0.0.0",
  "description": "Turn a git history into an animated low-poly 3D city on a static webpage.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-city": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:page",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:page": "node scripts/build-page.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "web-tree-sitter": "0.27.1"
  }
}
